{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(target/debug/papo --help)",
      "Bash(target/debug/papo --version)",
      "Bash(target/debug/papo status:*)",
      "Bash(target/debug/papo log:*)"
    ]
  }
}
